---
const steps = [
  {
    label: "Captura",
    title: "Recopila el pulso en tiempo real",
    description:
      "Conecta API sociales, formularios y chatbots para centralizar cada interacción.",
  },
  {
    label: "Analiza",
    title: "Clasificación automática de sentimientos",
    description:
      "El modelo detecta polaridad, temas dominantes y confianza en cuestión de segundos.",
  },
  {
    label: "Comparte",
    title: "Visualiza y comparte insights",
    description:
      "Comparte dashboards en vivo o exporta reportes visualmente impactantes.",
  },
];
---

<section
  class="relative overflow-hidden rounded-3xl border border-white/50 bg-white/75 px-6 py-12 shadow-[0_45px_80px_-45px_rgba(15,23,42,0.35)] backdrop-blur-xl sm:px-12"
>
  <div
    class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-slate-300/70 to-transparent"
    aria-hidden="true"
  >
  </div>
  <div class="relative mx-auto flex max-w-5xl flex-col gap-10">
    <header class="space-y-3 text-center">
      <span
        class="inline-flex items-center gap-2 rounded-full bg-white/90 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-slate-600 ring-1 ring-slate-900/10"
      >
        Flujo ideal
      </span>
      <h2 class="text-3xl font-semibold text-slate-900 sm:text-4xl">
        Un recorrido elegante de extremo a extremo
      </h2>
      <p class="mx-auto max-w-2xl text-base text-slate-600">
        Presenta el journey de tu dashboard con un timeline suave que explica
        cada etapa con claridad.
      </p>
    </header>

    <ol
      class="relative space-y-8 before:absolute before:left-4 before:top-0 before:h-full before:w-px before:bg-gradient-to-b before:from-emerald-300/80 before:via-slate-200 before:to-slate-300 sm:space-y-10 sm:before:left-1/2 sm:before:-translate-x-1/2"
    >
      {
        steps.map((step, index) => (
          <li class="relative flex flex-col gap-4 sm:flex-row sm:items-center">
            <div class="flex items-center gap-4 sm:w-1/2 sm:justify-end sm:pr-12">
              <div
                class={`flex h-12 w-12 items-center justify-center rounded-full border border-white/70 bg-slate-900/90 text-sm font-semibold tracking-wide text-white shadow-lg shadow-slate-900/30 sm:order-last`}
              >
                {String(index + 1).padStart(2, "0")}
              </div>
              <div class="max-w-xs text-sm font-semibold uppercase tracking-wide text-slate-500">
                {step.label}
              </div>
            </div>
            <div class="sm:w-1/2 sm:pl-12">
              <div class="rounded-2xl border border-white/60 bg-white/90 p-6 shadow-sm">
                <h3 class="text-xl font-semibold text-slate-900">
                  {step.title}
                </h3>
                <p class="mt-2 text-sm leading-relaxed text-slate-600">
                  {step.description}
                </p>
              </div>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>
